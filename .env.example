# =============================================================================
# Dashforge environment variables
# Source of truth: Engineering Document §16.2
# Copy this file to `.env` and fill in real values for local development.
# Production values live in Railway as project-scoped variables / secrets.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- URLs ----
# Public URL of the web service (what the browser hits)
APP_ORIGIN=http://localhost:5173
# Public URL of the api service. In production the api service is NOT publicly
# exposed; the web service proxies /v1/* over Railway's private network.
API_ORIGIN=http://localhost:3000
# Private-network URL the web service uses for SSR-side calls to api.
# In local dev this is the same as API_ORIGIN.
INTERNAL_API_URL=http://localhost:3000

# ---- Postgres ----
# Pooled connection used by api + worker for normal traffic.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dashforge
# Direct (unpooled) connection used by api ONLY for running migrations.
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/dashforge

# ---- Redis (BullMQ + rate limiting) ----
REDIS_URL=redis://localhost:6379

# ---- Encryption (Engineering Doc §10.2) ----
# 32 bytes, base64-encoded. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DO NOT reuse this key across environments. Rotation is manual (§10.4).
MASTER_ENCRYPTION_KEY=

# ---- Better-Auth ----
# Session signing key. Any sufficiently long random string (≥32 bytes recommended).
BETTER_AUTH_SECRET=

# ---- Google OAuth (FR-1.3) ----
# Created at console.cloud.google.com; redirect URI matches APP_ORIGIN/v1/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# ---- Resend (transactional email; FR-1.9) ----
# Free-tier key works against onboarding@resend.dev sender for dev. See §3.2.
RESEND_API_KEY=
