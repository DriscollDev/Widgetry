# =============================================================================
# Widgetry environment variables
# Copy this file to `.env` and fill in real values for local development.
# Production values live in Railway as project-scoped variables / secrets.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=debug
# Bind address/port for the api service. PORT must agree with API_ORIGIN below.
HOST=0.0.0.0
PORT=3000

# ---- URLs ----
# Public URL of the web service (what the browser hits)
APP_ORIGIN=http://localhost:5173
# Public URL of the api service. In production the api service is NOT publicly
# exposed; the web service proxies /v1/* over Railway's private network.
API_ORIGIN=http://localhost:3000
# Private-network URL the web service uses for SSR-side calls to api.
# In local dev this is the same as API_ORIGIN.
INTERNAL_API_URL=http://localhost:3000

# ---- Postgres ----
# Pooled connection used by api + worker for normal traffic.
DATABASE_URL=
# Direct (unpooled) connection used by api ONLY for running migrations.
DIRECT_DATABASE_URL=

# ---- Redis (BullMQ + rate limiting) ----
REDIS_URL=

# ---- Encryption ----
# 32 bytes, base64-encoded. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DO NOT reuse this key across environments. Rotation is manual (§10.4).
MASTER_ENCRYPTION_KEY=

# ---- Better-Auth ----
# Session signing key. Minimum 32 characters - the api refuses to start below
# that. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Note: there is deliberately no BETTER_AUTH_URL. Better-Auth's baseURL is
# APP_ORIGIN, because every auth link a user actually clicks (email
# verification, OAuth callbacks) must point at the web service, not the api.
BETTER_AUTH_SECRET=

# FR-1.5 checks new passwords against the Have I Been Pwned breach corpus via a
# k-anonymity prefix query (the password itself never leaves the process). The
# check FAILS CLOSED - if api.pwnedpasswords.com is unreachable, sign-up returns
# 500. Set false ONLY when working offline. Leave true everywhere else.
PASSWORD_BREACH_CHECK=true

# ---- Google OAuth ----
# Created at console.cloud.google.com; redirect URI matches APP_ORIGIN/v1/auth/callback/google
# Google sign-in registers only when BOTH are non-empty; blank is a supported
# state, so a developer without Google credentials can still boot the api.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# ---- Resend (transactional email, EX-15) ----
# Free-tier key works against onboarding@resend.dev sender for dev. See §3.2.
# Leave blank to work offline: the api then LOGS each verification/reset email,
# link included, instead of sending it. That fallback is dev-only - the api
# refuses to start with NODE_ENV=production and no key.
RESEND_API_KEY=
# Sender for auth emails. Bare address or "Display Name <address>". Resend only
# delivers from a verified domain, so the default sandbox sender stays until the
# team verifies one (§3.2 / risk register).
EMAIL_FROM=Widgetry <onboarding@resend.dev>

# ---- Integration tests ----
# `pnpm test:integration` skips silently unless DATABASE_URL resolves to a
# database whose name ends in `_ci_test`. That suffix is a hard guard, checked
# in two places: packages/db/src/reset.ts refuses to run without it, and every
# file in apps/api/test/integration/ gates on it. Neither can be talked round.
#
# In CI these come from GitHub Actions secrets (Eng §14.1, §16.2) and point at
# the shared `ci-test` environment. They belong in Actions secrets and NOT in
# Railway.
#
# To run the integration suite locally, point TEST_DATABASE_URL at your OWN
# throwaway Railway Postgres - the personal-throwaway fallback in Eng §17.3,
# same pattern as testing an un-merged migration. Name the database with a
# `_ci_test` suffix so it passes the guard, then:
#
#     pnpm --filter @widgetry/db migrate
#     pnpm --filter @widgetry/api test:integration
#
# Do NOT point this at the shared `ci-test` database. CI resets that database
# before every run - DROP SCHEMA public CASCADE plus a Redis flush - and the
# `integration-tests` concurrency group only serializes CI against CI. It cannot
# see your local run, so the two will eventually collide mid-suite.
# TEST_DATABASE_URL=
#
# Deliberately left unset even when TEST_DATABASE_URL is set. test/setup.ts
# blanks REDIS_URL when this is absent, which drops the rate limiter onto its
# in-process store - single-process, and exactly what the tests want. Pointed at
# a real Redis, the per-IP EX-42 buckets become shared state across concurrent
# runs and the 429 assertions go flaky.
# TEST_REDIS_URL=