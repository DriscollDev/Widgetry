{
  "name": "@widgetry/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Widgetry HTTP API (Fastify + Better-Auth + Drizzle).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "auth:generate": "auth generate --config src/auth.ts --output ../../packages/db/src/schema/auth.ts -y",
    "test": "vitest run",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@widgetry/db": "workspace:*",
    "@widgetry/shared": "workspace:*",
    "better-auth": "^1.6.25",
    "dotenv": "^17",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5",
    "resend": "^6.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "auth": "^1.6.25",
    "eslint": "^9.12.0",
    "drizzle-orm": "^0.45.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4",
    "vitest": "^3"
  }
}
