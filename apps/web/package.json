{
  "name": "@widgetry/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Widgetry web frontend (SvelteKit + Skeleton UI v3).",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "prepare": "svelte-kit sync",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "echo '[web] no integration tests yet' && exit 0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5",
    "@sveltejs/kit": "^2",
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tailwindcss/vite": "^4",
    "svelte": "^5",
    "svelte-check": "^4",
    "tailwindcss": "^4",
    "vite": "^6",
    "vitest": "^3"
  },
  "dependencies": {
    "@skeletonlabs/skeleton": "^3.2.2",
    "@skeletonlabs/skeleton-svelte": "^1.5.3",
    "@widgetry/shared": "workspace:*",
    "zod": "^4.4.3"
  }
}
