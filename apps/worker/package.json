{
  "name": "@widgetry/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Widgetry BullMQ worker: master scheduler, widget polling, snapshot retention purge.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration"
  },
  "dependencies": {
    "@widgetry/db": "workspace:*",
    "@widgetry/shared": "workspace:*",
    "bullmq": "^5",
    "dotenv": "^17",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5",
    "ipaddr.js": "^2.2.0",
    "pino": "^9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9.12.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4",
    "vitest": "^3"
  }
}
