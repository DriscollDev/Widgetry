{
  "name": "widgetry",
  "version": "0.1.0",
  "private": true,
  "description": "Widgetry - customizable widget-based API monitoring dashboards.",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @widgetry/web dev",
    "dev:api": "pnpm --filter @widgetry/api dev",
    "dev:worker": "pnpm --filter @widgetry/worker dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "build:web": "pnpm --filter @widgetry/web... build",
    "build:api": "pnpm --filter @widgetry/api... build",
    "build:worker": "pnpm --filter @widgetry/worker... build",
    "start:web": "pnpm --filter @widgetry/web start",
    "start:api": "pnpm --filter @widgetry/api start",
    "start:worker": "pnpm --filter @widgetry/worker start",
    "db:generate": "pnpm --filter @widgetry/db generate",
    "db:migrate": "pnpm --filter @widgetry/db migrate",
    "db:seed": "pnpm --filter @widgetry/db seed",
    "db:reset": "pnpm --filter @widgetry/db reset",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "eslint-plugin-svelte": "^3.22.0",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  }
}
